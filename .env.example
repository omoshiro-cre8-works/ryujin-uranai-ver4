APP_ENV=local
# APP_ENV values:
# - production/prod: existing production defaults are allowed
# - staging: FIRESTORE_PROJECT_ID, FIRESTORE_DATABASE_ID, FIRESTORE_COLLECTION_NAME, STRIPE_MODE=test are required
# - local/test: FIRESTORE_PROJECT_ID is required before Firestore access; Stripe live mode is rejected
APP_TITLE=龍神さまのお告げ
APP_SUBTITLE=巫女が龍神さまの声を聞き、あなたの運命を紐解きます。
LOG_LEVEL=INFO
GEMINI_MODEL=gemini-2.5-flash
APP_PASSPHRASE=your-passphrase
GEMINI_API_KEY=your-gemini-api-key
MIKO_IMAGE_PATH=miko.png
PDF_FONT_PATH_1=NotoSerifJP-Regular.ttf
PDF_FONT_PATH_2=SawarabiMincho-Regular.ttf
MAX_IMAGE_FILES=2
MAX_IMAGE_SIZE_MB=10
MAX_REVIEW_PDF_SIZE_MB=10
MAX_REVIEW_MEMO_LENGTH=1200
SHOW_DEBUG=false
GA4_ENABLED=false
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
GA4_API_SECRET=your-ga4-api-secret
FIRESTORE_PROJECT_ID=
FIRESTORE_DATABASE_ID=
FIRESTORE_COLLECTION_NAME=
STRIPE_MODE=test
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_PRICE_ID_REGULAR=price_regular_300yen
STRIPE_PRICE_ID_CAMPAIGN=price_campaign_100yen
STRIPE_REVIEW_PRICE_ID=price_review_680yen
STRIPE_PRICE_ID_REVIEW_CAMPAIGN=
REVIEW_AMOUNT_JPY=680
REVIEW_PLANNED_AMOUNT_JPY=780
REVIEW_CAMPAIGN_AMOUNT_JPY=680
CAMPAIGN_END_AT=2026-04-01T00:00:00
CAMPAIGN_TIMEZONE=Asia/Tokyo
# URL query examples only; not environment settings:
# test_mode=owner|none
# button_position=top|middle|bottom|unknown
